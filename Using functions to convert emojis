
def emoji_converter(message):
    emojis_mapping={
    ";)":"😉",
    ":)":"😊",
    ":(":"😢",
    ":|":"😑"                       
}
    words=message.split(" ")
    output=""
    for word in words:
        output+=emojis_mapping.get(word,word)+" "
    return output


message=input('>')
print(emoji_converter(message))





